# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Project Settings → API (or "API Keys")

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" public key (or the new "publishable" key). Safe to expose in the browser.
# NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your live site address (used for links in emails). e.g. https://suffah.pk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional: email alert for every new order (https://resend.com) ----
# Leave blank to switch email alerts off. New orders always appear in /admin.
RESEND_API_KEY=
ORDER_ALERT_EMAIL=
# Sender, must be a domain you verified in Resend. The default works only for testing.
RESEND_FROM=Suffah Orders <onboarding@resend.dev>
